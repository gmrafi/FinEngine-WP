{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "820px",
      "wideSize": "1200px"
    },
    "color": {
      "custom": true,
      "customDuotone": false,
      "customGradient": true,
      "defaultGradients": false,
      "defaultPalette": false,
      "palette": [
        {
          "slug": "primary",
          "color": "#0f766e",
          "name": "Emerald Primary"
        },
        {
          "slug": "primary-dark",
          "color": "#115e59",
          "name": "Deep Emerald"
        },
        {
          "slug": "secondary",
          "color": "#0f172a",
          "name": "Slate Navy"
        },
        {
          "slug": "accent",
          "color": "#0ea5e9",
          "name": "FinTech Cyan"
        },
        {
          "slug": "surface",
          "color": "#f8fafc",
          "name": "Surface Ice"
        },
        {
          "slug": "background",
          "color": "#ffffff",
          "name": "Pure White"
        },
        {
          "slug": "foreground",
          "color": "#0f172a",
          "name": "Text Dark"
        },
        {
          "slug": "muted",
          "color": "#64748b",
          "name": "Muted Slate"
        },
        {
          "slug": "border",
          "color": "#e2e8f0",
          "name": "Border Line"
        }
      ],
      "gradients": [
        {
          "slug": "emerald-to-slate",
          "gradient": "linear-gradient(135deg, #0f766e 0%, #0f172a 100%)",
          "name": "Emerald to Slate"
        },
        {
          "slug": "surface-glow",
          "gradient": "linear-gradient(135deg, #f0fdfa 0%, #f8fafc 100%)",
          "name": "Surface Glow"
        }
      ]
    },
    "typography": {
      "customFontSize": true,
      "fontStyle": true,
      "fontWeight": true,
      "letterSpacing": true,
      "lineHeight": true,
      "textColumns": false,
      "textDecoration": true,
      "textTransform": true,
      "fontFamilies": [
        {
          "fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Oxygen, Ubuntu, Cantarell, \"Helvetica Neue\", sans-serif",
          "name": "System Sans",
          "slug": "system-sans"
        },
        {
          "fontFamily": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace",
          "name": "Monospace",
          "slug": "monospace"
        }
      ],
      "fontSizes": [
        {
          "name": "Small",
          "size": "0.875rem",
          "slug": "small"
        },
        {
          "name": "Medium",
          "size": "1rem",
          "slug": "medium"
        },
        {
          "name": "Large",
          "size": "1.25rem",
          "slug": "large"
        },
        {
          "name": "X-Large",
          "size": "1.75rem",
          "slug": "x-large"
        },
        {
          "name": "XX-Large",
          "size": "2.5rem",
          "slug": "xx-large"
        },
        {
          "name": "Hero",
          "size": "3.25rem",
          "slug": "hero"
        }
      ]
    },
    "spacing": {
      "margin": true,
      "padding": true,
      "blockGap": true,
      "units": ["px", "em", "rem", "%", "vh", "vw"],
      "spacingSizes": [
        { "name": "1", "size": "0.25rem", "slug": "20" },
        { "name": "2", "size": "0.5rem", "slug": "30" },
        { "name": "3", "size": "1rem", "slug": "40" },
        { "name": "4", "size": "1.5rem", "slug": "50" },
        { "name": "5", "size": "2rem", "slug": "60" },
        { "name": "6", "size": "3rem", "slug": "70" },
        { "name": "7", "size": "4.5rem", "slug": "80" }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--background)",
      "text": "var(--wp--preset--color--foreground)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--system-sans)",
      "fontSize": "var(--wp--preset--font-size--medium)",
      "lineHeight": "1.6"
    },
    "spacing": {
      "blockGap": "1.5rem",
      "padding": {
        "top": "0px",
        "right": "var(--wp--preset--spacing--40)",
        "bottom": "0px",
        "left": "var(--wp--preset--spacing--40)"
      }
    },
    "elements": {
      "link": {
        "color": {
          "text": "var(--wp--preset--color--primary)"
        },
        ":hover": {
          "color": {
            "text": "var(--wp--preset--color--primary-dark)"
          }
        }
      },
      "heading": {
        "color": {
          "text": "var(--wp--preset--color--foreground)"
        },
        "typography": {
          "fontWeight": "700",
          "lineHeight": "1.25"
        }
      },
      "h1": {
        "typography": { "fontSize": "var(--wp--preset--font-size--hero)" }
      },
      "h2": {
        "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)" }
      },
      "h3": {
        "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" }
      },
      "h4": {
        "typography": { "fontSize": "var(--wp--preset--font-size--large)" }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--primary)",
          "text": "#ffffff"
        },
        "typography": {
          "fontWeight": "600",
          "fontSize": "1rem"
        },
        "border": {
          "radius": "8px"
        },
        "spacing": {
          "padding": {
            "top": "0.75rem",
            "right": "1.5rem",
            "bottom": "0.75rem",
            "left": "1.5rem"
          }
        },
        ":hover": {
          "color": {
            "background": "var(--wp--preset--color--primary-dark)",
            "text": "#ffffff"
          }
        }
      }
    }
  }
}
